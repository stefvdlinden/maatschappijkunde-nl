---
import BaseLayout from '../layouts/BaseLayout.astro';
import pages from '../../data/site/pages.json';

export function getStaticPaths() {
  return pages.map((page) => ({
    params: { slug: page.slugParam ?? undefined },
    props: { page }
  }));
}

const { page } = Astro.props;
const title = page.seoTitle || page.title || 'Maatschappijkunde.nl';
const description = page.description || undefined;
const isHome = page.url === '/';
const isWidePage = ['/examenstof/', '/begrippen/', '/downloads/'].includes(page.url);
const pagesByUrl = new Map(pages.map((item) => [item.url, item]));
const normalizeText = (value = '') => value
  .replace(/<[^>]*>/g, ' ')
  .replace(/\s+/g, ' ')
  .trim()
  .toLowerCase();
const descriptionText = normalizeText(description || '');
const bodyText = normalizeText(page.html || page.plainText || '');
const showIntro = Boolean(descriptionText) && !bodyText.includes(descriptionText);

const overviewGroups = [
  { title: 'Overzichten per onderwerp', items: pages.filter((item) => item.type === 'category' && !['/category/featured/', '/category/examenstof/'].includes(item.url)) },
  { title: 'Overzichten per niveau en examen', items: pages.filter((item) => item.type === 'ht_kb_tag') }
];

const buildBreadcrumbs = (currentPage) => {
  const crumbs = [{ href: '/', label: 'Home' }];
  if (currentPage.url === '/') return crumbs;

  const segments = currentPage.url.replace(/^\/|\/$/g, '').split('/').filter(Boolean);
  if (['category', 'kerndoel-tags', 'kerndoelen'].includes(segments[0])) {
    crumbs.push({ href: '/examenstof/', label: 'Examenstof' });
  }
  let path = '';
  for (const segment of segments.slice(0, -1)) {
    path += `/${segment}`;
    const href = `${path}/`;
    const matchedPage = pagesByUrl.get(href);
    if (matchedPage) crumbs.push({
      href,
      label: matchedPage.title
    });
  }
  crumbs.push({ label: currentPage.title });
  return crumbs;
};

const breadcrumbs = buildBreadcrumbs(page);
---
<BaseLayout title={title} description={description} breadcrumbs={breadcrumbs}>
  {isHome ? (
    <div class="home-page" set:html={page.html} />
  ) : (
    <article class:list={['content-page', 'article-content', { 'content-page--wide': isWidePage }]}>
      <p class="content-page__type">{page.typeLabel}</p>
      <h1>{page.title}</h1>
      {showIntro && <p class="content-page__intro">{description}</p>}
      {page.html && <div class="content-body" set:html={page.html} />}
      {page.url === '/examenstof/' && (
        <nav aria-label="Meer examenstofoverzichten" class="subject-grid">
          {overviewGroups.map((group) => (
            <section class="subject-card">
              <h2>{group.title}</h2>
              <ul>{group.items.map((item) => <li><a href={item.url}>{item.title}</a></li>)}</ul>
            </section>
          ))}
        </nav>
      )}
    </article>
  )}
</BaseLayout>
